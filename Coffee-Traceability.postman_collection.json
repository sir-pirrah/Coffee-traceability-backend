              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Events are CONFIRMED by the mock ledger', () => {",
                  "  const events = pm.response.json().data;",
                  "  if (events.length) { pm.expect(events[0].status).to.eql('CONFIRMED'); }",
