    {
      "name": "12. Security checks",
      "item": [
        {
          "name": "No token -> 401",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{apiBase}}/users/me" },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }
          ]
        },
        {
          "name": "Malformed token -> 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-real-jwt" }],
            "url": "{{apiBase}}/users/me"
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }
          ]
        },
        {
          "name": "Rate limit auth endpoint (run 12x rapidly)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{apiBase}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"wrong\"\n}" },
            "description": "AUTH_RATE_LIMIT_MAX defaults to 10 per 15 min window. Use Postman's Collection Runner to fire this 12+ times back-to-back and confirm you eventually get a 429."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Either 401 (bad creds) or 429 (rate limited)', () => {",
                  "  pm.expect([401, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
